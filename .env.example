FC_REGION=cn-hangzhou
FC_FUNCTION_NAME=wavelog
# Push a linux/amd64 image to ACR in the same region; prefer an immutable digest.
FC_IMAGE=registry.cn-hangzhou.aliyuncs.com/YOUR_NAMESPACE/wavelog-fc:3.2.4-fc1
FC_ROLE=acs:ram::YOUR_ACCOUNT_ID:role/YOUR_FC_EXECUTION_ROLE
FC_VPC_ID=vpc-REPLACE_ME
FC_VSWITCH_ID=vsw-REPLACE_ME
FC_SECURITY_GROUP_ID=sg-REPLACE_ME
# Existing NAS mount target and an existing export directory.
FC_NAS_SERVER=REPLACE_ME.cn-hangzhou.nas.aliyuncs.com:/wavelog
WAVELOG_BASE_URL=https://log.example.com/
# Generate each value separately: openssl rand -hex 32
WAVELOG_CRON_TOKEN=REPLACE_WITH_64_HEX_CHARACTERS
WAVELOG_INSTALL_TOKEN=REPLACE_WITH_ANOTHER_64_HEX_CHARACTERS
WAVELOG_INSTALL_ENABLED=false
